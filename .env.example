# Copy to .env.local and fill in to switch from committed fixtures to the live TMDB API.
#
# The app runs fully offline with NO key: lib/fixtures/source.ts flips the transport
# inside lib/bff/upstream/tmdb.ts, and nothing above that module branches on it.
# Get a key: https://www.themoviedb.org/settings/api (free, personal/non-commercial).
#
# Server-side only. Never prefix with NEXT_PUBLIC_ — the BFF is the only thing that
# talks to TMDB.
TMDB_API_KEY=

# Set to 1 to also serve posters from committed fixtures/images/ instead of
# image.tmdb.org, for genuinely offline (no network at all) development.
OFFLINE=0
